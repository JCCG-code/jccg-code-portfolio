# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection settings
# These are used by Docker Compose and the application

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=jccg_portfolio

# Database URL (for Drizzle ORM or other ORMs)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Nuxt runtime config - accessible via useRuntimeConfig()

# Base URL for the application (used in production)
# NUXT_PUBLIC_BASE_URL=https://yourapp.com

# API endpoints (if using external APIs)
# NUXT_PUBLIC_API_URL=https://api.yourapp.com

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# Add your authentication secrets here when implementing auth

# Session secret for JWT or session encryption
# NUXT_SESSION_SECRET=your-super-secret-key-here

# OAuth credentials (Google, GitHub, etc.)
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# Add API keys for third-party services as needed

# Analytics (Google Analytics, Plausible, etc.)
# NUXT_PUBLIC_GA_ID=
# NUXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Email service (SendGrid, Mailgun, etc.)
# NUXT_MAIL_HOST=
# NUXT_MAIL_PORT=
# NUXT_MAIL_USER=
# NUXT_MAIL_PASS=

# Cloud storage (S3, Cloudinary, etc.)
# NUXT_S3_BUCKET=
# NUXT_S3_REGION=
# NUXT_S3_ACCESS_KEY=
# NUXT_S3_SECRET_KEY=

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Development-specific settings

# Enable debug mode (shows detailed error pages)
# NODE_ENV=development

# Port for dev server (default: 3000)
# PORT=3000
